# Credora Local Development Environment Variables
# Copy this file to .env.local for local execution:
# cp .env.example .env.local

# Web Application URL (used for QR codes and verification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local Ethereum RPC Endpoint (Hardhat local node default: http://127.0.0.1:8545)
LOCAL_RPC_URL="http://127.0.0.1:8545"

# Authorized Issuer Private Key (Server-side ONLY. NEVER prefix with NEXT_PUBLIC_)
# Default is Hardhat standard Account #0 (0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
ISSUER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Optional override: Deployed CredentialRegistry contract address.
# If omitted or empty, the backend automatically reads the address from lib/contracts/deployment.json
CREDENTIAL_REGISTRY_ADDRESS=""
